<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com">
    <application
        android:allowBackup="true"
        android:label="MazeGame"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:supportsRtl="true">
        
        <!-- Полностью убрали двоеточия во внутренних атрибутах для обхода фильтра GitHub -->
        <activity
            name="${actName}"
            exported="true">
            <intent-filter>
                <action name="${actMain}" />
                <category name="${actLauncher}" />
            </intent-filter>
        </activity>
        
    </application>
</manifest>
